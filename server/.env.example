# Server
PORT=4000
# Comma-separated list of allowed browser origins (web app dev + prod URLs).
CLIENT_ORIGINS=http://localhost:3000
# Set to 1 only when deployed behind a reverse proxy (Cloud Run, Render, etc).
# TRUST_PROXY=1
# The web app's own URL - used to build password-reset links that point at
# our /reset-password page instead of Firebase's unreliable hosted one.
APP_URL=http://localhost:3000

# Firebase Admin SDK - service account credentials
# Generate from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the escaped \n newlines when pasting the private key here
FIREBASE_PRIVATE_KEY=

# organization-all-system integration (see services/orgSystemClient.service.ts) -
# base URL of that sibling system's Express server, and the shared secret it
# expects as the x-integration-key header on /api/integrations/*. Must match
# INTEGRATION_API_KEY in that system's own server env.
ORG_SYSTEM_BASE_URL=
ORG_SYSTEM_INTEGRATION_KEY=
